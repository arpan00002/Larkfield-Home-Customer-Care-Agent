# Copy to .env and fill in. Never commit .env.
#
# Any OpenAI-compatible provider works. Groq shortcut:
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Generic provider (wins over the Groq shortcut):
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini

# off = never call a model; auto = only when extraction is ambiguous;
# on = every ticket (so every response carries model id + token counts).
LLM_ASSIST=on

# Published per-1M-token rates for cost_usd (no "$" sign).
PRICE_INPUT_PER_M=0.15
PRICE_OUTPUT_PER_M=0.60

# LLM_MAX_TOKENS=600
# LLM_REASONING_EFFORT=low
# LLM_JSON_MODE=0
